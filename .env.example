# OpenAI-Compatible LLM Endpoint (DeepSeek / OpenRouter / vLLM / DashScope / OpenAI)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1

# Dual-Role Models (Lightweight Actor + Strong Reasoning Reflector/Merger)
ACTOR_MODEL=deepseek-v4.1-flash
REFLECTOR_MODEL=deepseek-v4-pro

# Concurrency, Timeout & Warehouse Dialect
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_SEC=90
DEFAULT_DIALECT=odps
